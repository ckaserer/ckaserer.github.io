---
import cv from '../data/cv.json';

export interface Props {
  /** Which page this nav renders on — controls whether section links are same-page anchors or cross-page links back to "/". */
  current?: 'home' | 'blog';
}

const { current = 'home' } = Astro.props;
const prefix = current === 'home' ? '' : '/';
const logoHref = current === 'home' ? '#top' : '/';

const sectionLinks = [
  { href: `${prefix}#about`, label: 'About' },
  { href: `${prefix}#experience`, label: 'Experience' },
  { href: `${prefix}#skills`, label: 'Skills' },
  { href: `${prefix}#education`, label: 'Education' },
  { href: `${prefix}#contact`, label: 'Contact' },
];
---

<nav class="fixed top-0 inset-x-0 z-50 bg-canvas/80 backdrop-blur-md border-b border-border/60 no-print" id="main-nav" aria-label="Primary">
  <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-16 h-16 flex items-center justify-between">
    <a href={logoHref} class="flex items-center gap-2.5 group">
      <span class="w-9 h-9 rounded-lg bg-gradient-azure flex items-center justify-center font-display font-bold text-white text-sm shadow-azure group-hover:scale-105 transition-transform">
        {cv.initials}
      </span>
      <span class="font-display font-bold text-navy text-sm">ckaserer.dev</span>
    </a>

    <!-- Desktop nav -->
    <div class="hidden md:flex items-center gap-8 text-sm font-medium text-muted">
      {sectionLinks.map((link) => (
        <a href={link.href} class="hover:text-azure transition-colors">{link.label}</a>
      ))}
      <a
        href="/blog"
        class:list={['hover:text-azure transition-colors', { 'text-azure': current === 'blog' }]}
      >
        Blog
      </a>
      <a
        href="/clemens-kaserer-cv.pdf" download="clemens-kaserer-cv.pdf"
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-azure text-white text-xs font-bold hover:bg-azure-dark transition-all duration-300 shadow-md hover:shadow-azure"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd"/>
        </svg>
        Download CV
      </a>
    </div>

    <!-- Mobile hamburger -->
    <button
      id="mobile-nav-toggle"
      type="button"
      class="md:hidden inline-flex items-center justify-center w-10 h-10 rounded-lg border border-border text-navy hover:border-azure hover:text-azure transition-colors"
      aria-controls="mobile-nav-menu"
      aria-expanded="false"
      aria-label="Toggle navigation menu"
    >
      <svg class="w-5 h-5 menu-open" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
      <svg class="w-5 h-5 menu-close hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M6 18L18 6"/>
      </svg>
    </button>
  </div>

  <!-- Mobile menu panel -->
  <div id="mobile-nav-menu" class="hidden md:hidden border-t border-border bg-canvas">
    <div class="px-6 py-4 flex flex-col gap-1 text-base font-medium text-navy">
      {sectionLinks.map((link) => (
        <a href={link.href} class="px-3 py-3 rounded-lg hover:bg-surface hover:text-azure transition-colors">{link.label}</a>
      ))}
      <a
        href="/blog"
        class:list={['px-3 py-3 rounded-lg hover:bg-surface hover:text-azure transition-colors', { 'text-azure': current === 'blog' }]}
      >
        Blog
      </a>
      <a
        href="/clemens-kaserer-cv.pdf" download="clemens-kaserer-cv.pdf"
        class="mt-2 inline-flex items-center justify-center gap-2 px-4 py-3 rounded-lg bg-azure text-white text-sm font-bold hover:bg-azure-dark transition-colors shadow-md"
      >
        <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd"/>
        </svg>
        Download CV
      </a>
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById('mobile-nav-toggle');
  const menu = document.getElementById('mobile-nav-menu');
  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('hidden', !open);
      toggle.querySelector('.menu-open')?.classList.toggle('hidden', open);
      toggle.querySelector('.menu-close')?.classList.toggle('hidden', !open);
    };
    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  }
</script>
