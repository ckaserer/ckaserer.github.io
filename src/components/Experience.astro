---
import cv from '../data/cv.json';

function formatDate(dateStr: string | null): string {
  if (!dateStr) return 'Present';
  const [year, month] = dateStr.split('-');
  const date = new Date(parseInt(year), parseInt(month) - 1);
  return date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
}
---

<section id="experience" class="relative bg-surface py-24 md:py-32 px-6 md:px-12 lg:px-16 overflow-hidden">
  <!-- Subtle dot grid -->
  <div class="absolute inset-0 dot-grid opacity-50 pointer-events-none" aria-hidden="true"></div>

  <div class="relative z-10 max-w-7xl mx-auto">
    <p class="section-label mb-4">Career</p>
    <h2 class="section-heading mb-4">Experience</h2>
    <p class="section-subheading mb-16">A decade of shipping cloud infrastructure and building engineering teams.</p>

    <div class="space-y-12">
      {cv.experience.map((employer) => (
        <div class="reveal">
          <!-- Company header -->
          <div class="flex items-center gap-4 mb-6">
            <div class="w-12 h-12 rounded-xl bg-gradient-azure flex items-center justify-center font-display font-bold text-white shadow-azure">
              {employer.company.charAt(0)}
            </div>
            <div>
              {employer.url ? (
                <a href={employer.url} target="_blank" rel="noopener noreferrer"
                   class="font-display font-bold text-navy text-2xl hover:text-azure transition-colors">
                  {employer.company}
                </a>
              ) : (
                <span class="font-display font-bold text-navy text-2xl">{employer.company}</span>
              )}
            </div>
          </div>

          <!-- Roles timeline -->
          <div class="relative ml-6 border-l-2 border-border space-y-8 pl-8">
            {employer.roles.map((role) => (
              <div class="relative">
                <!-- Timeline dot -->
                <div class={`absolute -left-[2.55rem] top-1.5 w-4 h-4 rounded-full border-4 ${role.end === null ? 'bg-azure border-azure ring-4 ring-azure/20' : 'bg-canvas border-border'}`}></div>

                <div class="bg-canvas border border-border rounded-2xl p-6 md:p-8 hover:border-azure/40 hover:shadow-navy transition-all duration-300">
                  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-2 mb-3">
                    <h3 class="font-display font-bold text-navy text-xl">{role.title}</h3>
                    {role.end === null && (
                      <span class="text-xs font-bold uppercase tracking-wider text-white bg-azure px-2.5 py-1 rounded-full">Current</span>
                    )}
                  </div>

                  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted mb-4">
                    <span class="font-medium text-navy/70">{formatDate(role.start)} — {formatDate(role.end)}</span>
                    <span class="text-border">·</span>
                    <span>{role.location}</span>
                  </div>

                  <p class="text-navy/75 leading-relaxed mb-4">{role.description}</p>

                  <ul class="space-y-2">
                    {role.highlights.map((h) => (
                      <li class="flex items-start gap-3 text-navy/85 text-sm md:text-base">
                        <svg class="w-5 h-5 text-azure mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                        </svg>
                        <span>{h}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
