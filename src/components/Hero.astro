---
import cv from '../data/cv.json';
const hasPhoto = Boolean(cv.photo);
const employer = cv.experience[0]?.company ?? '';
const city = (cv.location ?? '').split(',')[0]?.trim() ?? '';
const pillText = [employer, city].filter(Boolean).join(' · ');
---

<header id="top" class="relative min-h-screen flex items-center bg-canvas overflow-hidden pt-20">
  <!-- Decorative dot grid -->
  <div class="absolute inset-0 dot-grid opacity-60 pointer-events-none" aria-hidden="true"></div>

  <!-- Azure gradient blob top right -->
  <div class="absolute -top-40 -right-40 w-[40rem] h-[40rem] rounded-full pointer-events-none"
       style="background: radial-gradient(circle, rgba(0,120,212,0.18) 0%, transparent 65%); filter: blur(60px);"
       aria-hidden="true"></div>
  <!-- Sky cyan blob bottom left -->
  <div class="absolute -bottom-40 -left-40 w-[32rem] h-[32rem] rounded-full pointer-events-none"
       style="background: radial-gradient(circle, rgba(80,230,255,0.18) 0%, transparent 65%); filter: blur(60px);"
       aria-hidden="true"></div>

  <div class="relative z-10 max-w-7xl mx-auto w-full px-6 md:px-12 lg:px-16 py-16 grid lg:grid-cols-12 gap-12 items-center">
    <!-- Left: text content -->
    <div class="lg:col-span-7 reveal visible">
      <!-- Pill label -->
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-azure/10 border border-azure/20 text-azure text-xs font-bold uppercase tracking-[0.2em] mb-8">
        <span class="w-2 h-2 rounded-full bg-azure animate-pulse"></span>
        {pillText}
      </div>

      <!-- Giant name -->
      <h1 class="font-display font-black text-navy leading-[0.92] tracking-tightest"
          style="font-size: clamp(3.5rem, 9vw, 7.5rem);">
        <span class="block">Clemens</span>
        <span class="block bg-gradient-azure bg-clip-text text-transparent">Kaserer</span>
      </h1>

      <!-- Azure rule + role -->
      <div class="flex items-center gap-4 mt-8">
        <div class="w-16 h-1 rounded-full bg-gradient-azure shrink-0"></div>
        <p class="text-navy font-semibold text-lg md:text-xl">{cv.title}</p>
      </div>

      <!-- Tagline -->
      <p class="mt-6 text-muted text-base md:text-lg leading-relaxed max-w-xl">
        {cv.tagline}
      </p>

      <!-- CTAs -->
      <div class="mt-10 flex flex-wrap gap-3">
        <a
          href="/clemens-kaserer-cv.pdf"
          download="clemens-kaserer-cv.pdf"
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-azuretext-white font-semibold hover:bg-azure-dark transition-all duration-300 hover:-translate-y-0.5 shadow-azure"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd"/>
          </svg>
          Download CV
        </a>
        <a
          href={`https://www.linkedin.com/in/${cv.linkedin}`}
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl border-2 border-border text-navy font-semibold hover:border-navy hover:-translate-y-0.5 transition-all duration-300"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          LinkedIn
        </a>
        <a
          href={`https://github.com/${cv.github}`}
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl border-2 border-border text-navy font-semibold hover:border-navy hover:-translate-y-0.5 transition-all duration-300"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          GitHub
        </a>
      </div>
    </div>

    <!-- Right: photo -->
    <div class="lg:col-span-5 flex justify-center lg:justify-end reveal reveal-delay-2 visible">
      <div class="relative">
        <!-- Floating azure square decoration -->
        <div class="absolute -top-6 -right-6 w-24 h-24 rounded-2xl bg-gradient-azure opacity-90 -z-10 rotate-12"></div>
        <!-- Floating sky dot decoration -->
        <div class="absolute -bottom-8 -left-8 w-16 h-16 rounded-full bg-sky/40 -z-10"></div>

        {hasPhoto ? (
          <div class="photo-ring shadow-azure">
            <img
              src={cv.photo}
              alt={`Portrait of ${cv.name}`}
              class="w-72 h-72 md:w-80 md:h-80 object-cover rounded-[1.25rem]"
              width="320" height="320"
              loading="eager"
            />
          </div>
        ) : (
          <div class="w-72 h-72 md:w-80 md:h-80 rounded-3xl bg-gradient-azure flex items-center justify-center font-display font-black text-white text-8xl shadow-azure">
            {cv.initials}
          </div>
        )}

        <!-- Available-for-work pill -->
        <div class="absolute -bottom-4 left-1/2 -translate-x-1/2 bg-canvas border border-border rounded-full px-4 py-2 shadow-lg flex items-center gap-2 whitespace-nowrap">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span class="text-xs font-semibold text-navy">Open to conversations</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll cue -->
  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 animate-bounce opacity-40 no-print">
    <svg class="w-5 h-5 text-navy" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
    </svg>
  </div>
</header>
