---
import cv from '../data/cv.json';
---

<header class="relative min-h-screen flex items-center justify-center bg-canvas overflow-hidden">
  <!-- Parallax blob shapes -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div
      data-parallax="30"
      class="blob absolute top-[10%] left-[15%] w-[36rem] h-[36rem] rounded-full"
      style="background: radial-gradient(circle, #C9663B22 0%, transparent 70%); filter: blur(60px);"
    ></div>
    <div
      data-parallax="-20"
      class="blob absolute bottom-[10%] right-[10%] w-[28rem] h-[28rem] rounded-full"
      style="background: radial-gradient(circle, #C9663B18 0%, transparent 70%); filter: blur(80px);"
    ></div>
    <div
      data-parallax="15"
      class="blob absolute top-[50%] right-[25%] w-[20rem] h-[20rem] rounded-full"
      style="background: radial-gradient(circle, #111110 0.8px, transparent 1px); background-size: 28px 28px; opacity: 0.04;"
    ></div>
  </div>

  <div class="relative z-10 text-center px-6 max-w-4xl mx-auto">
    <!-- Monogram -->
    <div class="mx-auto mb-10 w-20 h-20 rounded-2xl bg-ink flex items-center justify-center text-2xl font-display font-bold text-canvas shadow-xl rotate-3 hover:rotate-0 transition-transform duration-500">
      {cv.initials}
    </div>

    <!-- Name -->
    <h1 class="font-display text-6xl md:text-8xl font-bold text-ink tracking-tight mb-4 leading-none">
      {cv.name}
    </h1>

    <!-- Title — terracotta accent line underneath -->
    <div class="flex items-center justify-center gap-3 mb-6">
      <div class="h-px w-12 bg-accent"></div>
      <p class="text-accent font-semibold text-lg md:text-xl tracking-wide">{cv.title}</p>
      <div class="h-px w-12 bg-accent"></div>
    </div>

    <!-- Tagline -->
    <p class="text-muted text-lg md:text-xl max-w-2xl mx-auto mb-12 leading-relaxed">
      {cv.tagline}
    </p>

    <!-- CTAs -->
    <div class="flex flex-wrap gap-4 justify-center">
      <a
        href="/cv.pdf"
        download
        class="inline-flex items-center gap-2 px-7 py-3.5 rounded-xl bg-ink hover:bg-accent text-canvas font-semibold transition-all duration-300 shadow-lg hover:shadow-accent/20 hover:-translate-y-0.5"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
        Download CV
      </a>
      <a
        href={`https://github.com/${cv.github}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-7 py-3.5 rounded-xl border-2 border-border hover:border-ink text-ink font-semibold transition-all duration-300 hover:-translate-y-0.5"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
        GitHub
      </a>
      <a
        href={`https://www.linkedin.com/in/${cv.linkedin}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-7 py-3.5 rounded-xl border-2 border-border hover:border-ink text-ink font-semibold transition-all duration-300 hover:-translate-y-0.5"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
        LinkedIn
      </a>
    </div>
  </div>

  <!-- Scroll cue -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce opacity-40">
    <svg class="w-6 h-6 text-ink" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </div>
</header>

<script>
  const blobs = document.querySelectorAll<HTMLElement>('[data-parallax]');

  document.addEventListener('mousemove', (e: MouseEvent) => {
    const xFrac = (e.clientX / window.innerWidth - 0.5) * 2;
    const yFrac = (e.clientY / window.innerHeight - 0.5) * 2;
    blobs.forEach((blob) => {
      const depth = parseFloat(blob.dataset.parallax ?? '0');
      blob.style.transform = `translate(${xFrac * depth}px, ${yFrac * depth}px)`;
    });
  });
</script>
  <!-- Background gradient mesh -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-brand-600/20 rounded-full blur-3xl"></div>
    <div class="absolute bottom-1/4 right-1/4 w-80 h-80 bg-brand-800/15 rounded-full blur-3xl"></div>
    <div class="absolute inset-0 bg-[linear-gradient(to_bottom,transparent_60%,rgb(2_6_23)_100%)]"></div>
  </div>

  <!-- Grid texture overlay -->
  <div class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg%20width%3D%2260%22%20height%3D%2260%22%20viewBox%3D%220%200%2060%2060%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cg%20fill%3D%22none%22%20fill-rule%3D%22evenodd%22%3E%3Cpath%20d%3D%22M60%200H0v60%22%20stroke%3D%22%23ffffff%22%20stroke-opacity%3D%220.03%22%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E')] opacity-50"></div>

  <div class="relative z-10 text-center px-6 max-w-4xl mx-auto">
    <!-- Monogram / avatar -->
    <div class="mx-auto mb-8 w-24 h-24 rounded-full bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center text-3xl font-bold text-white shadow-2xl shadow-brand-900/50 ring-4 ring-brand-500/20">
      {cv.initials}
    </div>

    <!-- Name -->
    <h1 class="text-5xl md:text-7xl font-bold text-white tracking-tight mb-4">
      {cv.name}
    </h1>

    <!-- Title -->
    <p class="text-xl md:text-2xl text-brand-400 font-medium mb-6">
      {cv.title}
    </p>

    <!-- Tagline -->
    <p class="text-slate-400 text-lg md:text-xl max-w-2xl mx-auto mb-10 leading-relaxed">
      {cv.tagline}
    </p>

    <!-- CTAs -->
    <div class="flex flex-wrap gap-4 justify-center">
      <a
        href="/cv.pdf"
        download
        class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-brand-600 hover:bg-brand-500 text-white font-semibold transition-colors duration-200 shadow-lg shadow-brand-900/30"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
        Download CV
      </a>
      <a
        href={`https://github.com/${cv.github}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-slate-800 hover:bg-slate-700 text-white font-semibold transition-colors duration-200 border border-slate-700"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
        GitHub
      </a>
      <a
        href={`https://www.linkedin.com/in/${cv.linkedin}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-slate-800 hover:bg-slate-700 text-white font-semibold transition-colors duration-200 border border-slate-700"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
        LinkedIn
      </a>
    </div>

    <!-- Scroll cue -->
    <div class="mt-16 animate-bounce opacity-50">
      <svg class="mx-auto w-6 h-6 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </div>
  </div>
</header>
