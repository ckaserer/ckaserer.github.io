---
import cv from '../data/cv.json';

const categories = [
  { key: 'azurePlatform', label: 'Azure Platform',                 icon: 'cloud' },
  { key: 'cloudNative',   label: 'Cloud-Native & Containers',      icon: 'box' },
  { key: 'automation',    label: 'Automation, CI/CD & Scripting',  icon: 'code' },
  { key: 'ai',            label: 'AI-Augmented Engineering',       icon: 'zap' },
  { key: 'practices',     label: 'Leadership & Practices',         icon: 'users' },
] as const;
---

<section id="skills" class="relative bg-canvas py-24 md:py-32 px-6 md:px-12 lg:px-16">
  <div class="max-w-7xl mx-auto">
    <p class="section-label mb-4">Expertise</p>
    <h2 class="section-heading mb-4">Skills & Technologies</h2>
    <p class="section-subheading mb-16">From Azure Landing Zones to GitHub Copilot rollouts — the toolbox I work with day-to-day.</p>

    <!-- Category grid: 5 cards on lg → top row 3, bottom row 2 centered -->
    <div class="grid md:grid-cols-2 lg:grid-cols-6 gap-5">
      {categories.map(({ key, label, icon }, i) => {
        const items = cv.skills[key as keyof typeof cv.skills] ?? [];
        const positionClass =
          i === 3 ? 'lg:col-start-2' :
          i === 4 ? 'lg:col-start-4' : '';
        return (
          <div class={`reveal reveal-delay-${(i % 4) + 1} relative bg-canvas border border-border rounded-2xl p-6 hover:border-azure hover:-translate-y-1 hover:shadow-azure transition-all duration-300 lg:col-span-2 ${positionClass}`}>
            <!-- Top accent line -->
            <div class="absolute top-0 left-6 right-6 h-0.5 bg-gradient-azure rounded-full"></div>

            <div class="flex items-center gap-3 mb-4">
              <div class="w-9 h-9 rounded-lg bg-azure/10 flex items-center justify-center">
                <svg class="w-4 h-4 text-azure" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  {icon === 'cloud' && <path stroke-linecap="round" stroke-linejoin="round" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/>}
                  {icon === 'code' && <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>}
                  {icon === 'box' && <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>}
                  {icon === 'zap' && <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>}
                  {icon === 'terminal' && <path stroke-linecap="round" stroke-linejoin="round" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>}
                  {icon === 'users' && <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>}
                </svg>
              </div>
              <h3 class="font-display font-bold text-navy">{label}</h3>
            </div>

            <div class="flex flex-wrap gap-2">
              {items.map((skill) => (
                <span class="pill">{skill}</span>
              ))}
            </div>
          </div>
        );
      })}
    </div>

    <!-- Certifications -->
    <div class="mt-20">
      <div class="flex items-center gap-3 mb-8">
        <div class="w-8 h-8 rounded-lg bg-azure flex items-center justify-center">
          <svg class="w-4 h-4 text-white" viewBox="0 0 20 20" fill="currentColor">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
        </div>
        <h3 class="font-display font-bold text-navy text-2xl">Certifications</h3>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {cv.certifications.map((cert, i) => {
          const Tag = cert.url ? 'a' : 'div';
          const linkProps = cert.url
            ? { href: cert.url, target: '_blank', rel: 'noopener noreferrer', 'aria-label': `Verify credential: ${cert.name}` }
            : {};
          return (
            <Tag
              {...linkProps}
              class={`reveal reveal-delay-${(i % 3) + 1} group relative overflow-hidden bg-canvas border border-border rounded-xl p-5 hover:border-azure hover:-translate-y-0.5 transition-all duration-300 ${cert.url ? 'cursor-pointer block' : ''}`}
            >
              <!-- Hover accent -->
              <div class="absolute inset-x-0 top-0 h-1 bg-gradient-azure scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-300"></div>

              <div class="flex items-start gap-3">
                <div class="w-10 h-10 rounded-lg bg-azure/10 border border-azure/20 flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-azure" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </div>
                <div class="flex-1 min-w-0">
                  <div class="font-semibold text-navy text-sm leading-snug group-hover:text-azure transition-colors">{cert.name}</div>
                  <div class="text-muted text-xs mt-1.5 font-medium flex items-center gap-1.5">
                    <span>{cert.issuer} · {cert.year}</span>
                    {cert.url && (
                      <svg class="w-3 h-3 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                      </svg>
                    )}
                  </div>
                </div>
              </div>
            </Tag>
          );
        })}
      </div>
    </div>
  </div>
</section>
