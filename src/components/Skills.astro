---
import cv from '../data/cv.json';

const categories = [
  { key: 'cloud',    label: 'Cloud & Azure',    color: 'bg-blue-900/40 text-blue-300 border-blue-700/40' },
  { key: 'iac',      label: 'Infrastructure as Code', color: 'bg-purple-900/40 text-purple-300 border-purple-700/40' },
  { key: 'containers', label: 'Containers',     color: 'bg-cyan-900/40 text-cyan-300 border-cyan-700/40' },
  { key: 'cicd',     label: 'CI/CD & Automation', color: 'bg-emerald-900/40 text-emerald-300 border-emerald-700/40' },
  { key: 'languages', label: 'Languages',       color: 'bg-amber-900/40 text-amber-300 border-amber-700/40' },
  { key: 'practices', label: 'Leadership',      color: 'bg-rose-900/40 text-rose-300 border-rose-700/40' },
] as const;
---

<section id="skills" class="py-24 bg-slate-900">
  <div class="max-w-5xl mx-auto px-6">
    <p class="text-brand-400 text-sm font-semibold uppercase tracking-widest mb-3">Expertise</p>
    <h2 class="section-heading">Skills & Technologies</h2>
    <p class="section-subheading">From Kubernetes clusters to team architecture — here's what I work with.</p>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {categories.map(({ key, label, color }) => {
        const items = cv.skills[key as keyof typeof cv.skills] ?? [];
        return (
          <div class="bg-slate-800/50 border border-slate-700/40 rounded-xl p-6">
            <h3 class="text-white font-semibold mb-4">{label}</h3>
            <div class="flex flex-wrap gap-2">
              {items.map((skill) => (
                <span class={`badge border ${color} text-xs`}>{skill}</span>
              ))}
            </div>
          </div>
        );
      })}
    </div>

    <!-- Certifications -->
    <div class="mt-12">
      <h3 class="text-white font-semibold text-lg mb-6">Certifications</h3>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {cv.certifications.map((cert) => (
          <div class="bg-slate-800/40 border border-slate-700/30 rounded-lg p-4 flex items-start gap-3">
            <div class="w-8 h-8 rounded bg-brand-900/60 flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-4 h-4 text-brand-400" viewBox="0 0 20 20" fill="currentColor">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            </div>
            <div>
              <div class="text-white text-sm font-medium leading-snug">{cert.name}</div>
              <div class="text-slate-500 text-xs mt-1">{cert.issuer} · {cert.year}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
