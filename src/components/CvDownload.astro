---
import cv from '../data/cv.json';
---

<section id="cv" class="relative bg-navy overflow-hidden py-24 md:py-32 px-6 md:px-12 lg:px-16">
  <!-- Gradient overlays -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute -top-40 -left-40 w-[40rem] h-[40rem] rounded-full"
         style="background: radial-gradient(circle, rgba(0,120,212,0.4) 0%, transparent 65%); filter: blur(40px);"></div>
    <div class="absolute -bottom-40 -right-40 w-[40rem] h-[40rem] rounded-full"
         style="background: radial-gradient(circle, rgba(80,230,255,0.3) 0%, transparent 65%); filter: blur(40px);"></div>
  </div>

  <div class="relative z-10 max-w-5xl mx-auto grid md:grid-cols-5 gap-10 items-center">
    <!-- Photo on the side -->
    {cv.photo && (
      <div class="md:col-span-2 flex justify-center md:justify-start">
        <div class="photo-ring">
          <img src={cv.photo} alt={cv.name}
               class="w-44 h-44 md:w-52 md:h-52 object-cover rounded-[1.25rem]"/>
        </div>
      </div>
    )}

    <!-- Text + CTA -->
    <div class="md:col-span-3 text-center md:text-left">
      <p class="text-sky text-xs font-bold uppercase tracking-[0.2em] mb-4">Curriculum Vitae</p>
      <h2 class="font-display font-extrabold text-white leading-[1.05] tracking-tightest mb-6"
          style="font-size: clamp(2rem, 4.5vw, 3rem);">
        Want the full picture?
      </h2>
      <p class="text-white/70 text-base md:text-lg leading-relaxed mb-8 max-w-md mx-auto md:mx-0">
        Download my complete CV — work history, skills, and certifications. Always up to date, regenerated automatically.
      </p>

      <div class="flex flex-col sm:flex-row items-center md:items-start justify-center md:justify-start gap-4">
        <a
          href="/clemens-kaserer-cv.pdf"
          download="clemens-kaserer-cv.pdf"
          class="inline-flex items-center gap-2.5 px-8 py-4 rounded-xl bg-white text-navy hover:bg-sky-light font-semibold text-base transition-all duration-300 shadow-xl hover:-translate-y-0.5"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-azure" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd"/>
          </svg>
          Download PDF
        </a>
        <a
          href="/cv"
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-white/80 hover:text-white font-medium text-sm transition-colors underline underline-offset-4 decoration-white/30 hover:decoration-white"
        >
          View in browser
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
