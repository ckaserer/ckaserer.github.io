---
import cv from '../data/cv.json';
---

<section id="achievements" class="relative bg-surface py-24 md:py-32 px-6 md:px-12 lg:px-16">
  <div class="max-w-7xl mx-auto">
    <p class="section-label mb-4">Impact</p>
    <h2 class="section-heading mb-4">Selected Achievements</h2>
    <p class="section-subheading mb-16">Proof points from a decade of cloud engineering and AI-augmented delivery.</p>

    <div class="space-y-4">
      {cv.achievements.map((achievement, i) => (
        <div class={`reveal reveal-delay-${Math.min(i + 1, 5)} flex items-start gap-5 bg-canvas border border-border rounded-2xl p-6 md:p-8 hover:border-azure/50 hover:shadow-navy transition-all duration-300`}>
          <div class="w-10 h-10 rounded-xl bg-azure/10 border border-azure/20 flex items-center justify-center shrink-0 mt-0.5">
            <svg class="w-5 h-5 text-azure" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
            </svg>
          </div>
          <p class="text-navy/85 text-base md:text-lg leading-relaxed">{achievement}</p>
        </div>
      ))}
    </div>
  </div>
</section>
