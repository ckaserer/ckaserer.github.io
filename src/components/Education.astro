---
import cv from '../data/cv.json';
---

<section id="education" class="relative bg-surface py-24 md:py-32 px-6 md:px-12 lg:px-16">
  <div class="max-w-7xl mx-auto">
    <p class="section-label mb-4">Education</p>
    <h2 class="section-heading mb-16">Academic background.</h2>

    <div class="grid md:grid-cols-2 gap-5">
      {cv.education.map((edu, i) => (
        <div class={`reveal reveal-delay-${i + 1} bg-canvas border border-border rounded-2xl p-6 md:p-8 hover:border-azure hover:shadow-navy transition-all duration-300`}>
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-gradient-azure flex items-center justify-center shrink-0 shadow-azure">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/>
              </svg>
            </div>
            <div class="flex-1">
              <h3 class="font-display font-bold text-navy text-lg leading-snug mb-1">{edu.degree}</h3>
              <div class="text-azure font-semibold text-sm mb-2">{edu.institution}</div>
              <div class="text-muted text-xs font-medium uppercase tracking-wider">{[edu.start, edu.end].filter(Boolean).join(' — ')}</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
