---
import cv from '../data/cv.json';

// Internal page used to generate /og-image.png via Playwright snapshot.
// Sized exactly 1200x630 — see scripts/generate-og-image.mjs.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>OG Image — {cv.name}</title>
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
    <style>
      html, body { margin: 0; padding: 0; }
      body {
        width: 1200px;
        height: 630px;
        background: #FFFFFF;
        font-family: 'Inter', sans-serif;
        color: #0A1628;
        position: relative;
        overflow: hidden;
      }
      .blob-a {
        position: absolute; top: -200px; right: -200px;
        width: 700px; height: 700px; border-radius: 50%;
        background: radial-gradient(circle, rgba(0,120,212,0.30) 0%, transparent 65%);
        filter: blur(40px);
      }
      .blob-b {
        position: absolute; bottom: -200px; left: -150px;
        width: 600px; height: 600px; border-radius: 50%;
        background: radial-gradient(circle, rgba(80,230,255,0.28) 0%, transparent 65%);
        filter: blur(40px);
      }
      .dot-grid {
        position: absolute; inset: 0;
        background-image: radial-gradient(circle, #0A162810 1.5px, transparent 1.5px);
        background-size: 28px 28px;
        opacity: 0.7;
      }
      .frame {
        position: relative;
        z-index: 2;
        box-sizing: border-box;
        height: 100%;
        padding: 72px 80px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }
      .top-row {
        display: flex;
        align-items: center;
        gap: 16px;
      }
      .mark {
        width: 56px; height: 56px;
        border-radius: 14px;
        background: linear-gradient(135deg, #0078D4 0%, #50E6FF 100%);
        color: white;
        font-weight: 800;
        font-size: 24px;
        display: flex; align-items: center; justify-content: center;
        box-shadow: 0 16px 40px -16px rgba(0,120,212,0.55);
      }
      .brand { font-weight: 700; font-size: 20px; color: #0A1628; }
      .pill {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 6px 14px; border-radius: 9999px;
        background: rgba(0,120,212,0.10);
        border: 1px solid rgba(0,120,212,0.25);
        color: #0078D4;
        font-weight: 700; font-size: 13px;
        letter-spacing: 0.18em; text-transform: uppercase;
        margin-bottom: 28px;
      }
      .pill .dot { width: 8px; height: 8px; border-radius: 50%; background: #0078D4; }
      h1 {
        font-size: 96px; line-height: 0.95; font-weight: 900;
        letter-spacing: -0.04em;
        margin: 0;
      }
      .name-2 {
        background: linear-gradient(135deg, #0078D4 0%, #50E6FF 100%);
        -webkit-background-clip: text; background-clip: text; color: transparent;
      }
      .rule {
        width: 96px; height: 5px; border-radius: 4px;
        background: linear-gradient(135deg, #0078D4 0%, #50E6FF 100%);
        margin: 24px 0 18px;
      }
      .role { font-size: 26px; font-weight: 600; color: #0A1628; }
      .bottom {
        display: flex; align-items: flex-end; justify-content: space-between;
      }
      .url { color: #475569; font-weight: 600; font-size: 18px; }
      .stat {
        text-align: right;
      }
      .stat-value {
        font-size: 56px; font-weight: 900; line-height: 1;
        background: linear-gradient(135deg, #0078D4 0%, #50E6FF 100%);
        -webkit-background-clip: text; background-clip: text; color: transparent;
      }
      .stat-label {
        margin-top: 6px;
        font-size: 13px; font-weight: 600; color: #475569;
        text-transform: uppercase; letter-spacing: 0.14em;
      }
    </style>
  </head>
  <body>
    <div class="blob-a"></div>
    <div class="blob-b"></div>
    <div class="dot-grid"></div>

    <div class="frame">
      <div class="top-row">
        <div class="mark">{cv.initials}</div>
        <div class="brand">ckaserer.dev</div>
      </div>

      <div>
        <div class="pill"><span class="dot"></span> Avanade · Vienna</div>
        <h1>
          <span>Clemens</span><br/>
          <span class="name-2">Kaserer</span>
        </h1>
        <div class="rule"></div>
        <div class="role">{cv.title}</div>
      </div>

      <div class="bottom">
        <div class="url">ckaserer.dev</div>
        <div class="stat">
          <div class="stat-value">~3×</div>
          <div class="stat-label">AI-Augmented Delivery Speed</div>
        </div>
      </div>
    </div>
  </body>
</html>
