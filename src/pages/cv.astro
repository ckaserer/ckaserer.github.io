---
import cv from '../data/cv.json';
import '../styles/global.css';
// CV uses Carlito — the OFL, metric-compatible Calibri clone the source CV is set in.
// Self-hosted so the generated PDF actually embeds it (Google-Fonts Inter did not).
import '@fontsource/carlito/400.css';
import '@fontsource/carlito/400-italic.css';
import '@fontsource/carlito/700.css';

function formatDate(dateStr: string | null): string {
  if (!dateStr) return 'Present';
  const [year, month] = dateStr.split('-');
  const date = new Date(parseInt(year), parseInt(month) - 1);
  return date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
}

const allRoles = cv.experience.flatMap((employer) =>
  employer.roles.map((role) => ({ ...role, company: employer.company }))
);

const page1Roles = allRoles.slice(0, 4); // Avanade × 2, Gepardec, Accenture
const page2Roles = allRoles.slice(4);    // CERN, VAPC

const skillGroups = [
  { label: 'Azure & Platform',             items: cv.skills.azurePlatform },
  { label: 'Cloud-Native & Containers',    items: cv.skills.cloudNative   },
  { label: 'Automation & DevOps',          items: cv.skills.automation    },
  { label: 'AI-Augmented Engineering',     items: cv.skills.ai            },
  { label: 'Leadership & Practice',        items: cv.skills.practices     },
];

type CertFull = { name: string; issuer: string; year: number; url: string | null; level?: string; description?: string };

const certIssuers = ['Microsoft', 'GitHub', 'Leadership'];
const certsByIssuer = certIssuers
  .map(issuer => ({
    issuer,
    certs: (cv.certifications as unknown as CertFull[])
      .filter(c => c.issuer === issuer)
      .sort((a, b) => Number(b.year) - Number(a.year)),
  }))
  .filter(g => g.certs.length > 0);
const otherCerts = (cv.certifications as unknown as CertFull[]).filter(c => !certIssuers.includes(c.issuer));
if (otherCerts.length > 0) certsByIssuer.push({ issuer: 'Other', certs: otherCerts });

const languages = (cv as unknown as { languages?: Array<{ name: string; level: string }> }).languages ?? [];
const achievements = (cv as unknown as { achievements?: string[] }).achievements ?? [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{cv.name} — Curriculum Vitae</title>
    <meta name="robots" content="noindex" />
    <style>
      /* ─── Reset ──────────────────────────────────────────── */
      * { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --ink:    #0A1628;
        --soft:   #1e293b;
        --muted:  #475569;
        --dim:    #64748B;
        --rule:   #E2E8F0;
        --accent: #0078D4;
      }

      body {
        font-family: 'Carlito', 'Calibri', sans-serif;
        color: var(--ink);
        font-feature-settings: 'cv11', 'ss01';
      }

      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }

      /* ─── Document sections ───────────────────────────────── */
      /* Section divider is the heading underline (see .section-head) */

      .section-head {
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--accent);
        display: block;
        border-bottom: 1.5px solid var(--accent);
        padding-bottom: 0.28em;
      }

      /* Role */
      .role-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1rem;
      }
      .role-title   { font-weight: 700; color: var(--ink); }
      .role-date    { color: var(--dim); white-space: nowrap; flex-shrink: 0; }
      .role-meta    { color: var(--muted); font-weight: 500; }

      /* Bullet list — custom blue dot, works in both screen and print */
      .role-bullets { list-style: none; padding-left: 0; }
      .role-bullets li { color: var(--soft); line-height: 1.5; padding-left: 1.1em; position: relative; }
      .role-bullets li::before { content: '•'; color: var(--accent); font-weight: 700; position: absolute; left: 0; }

      /* Skills — block paragraph; bold lead-in label, items wrap to the left margin */
      .skill-row { }
      .skill-label { font-weight: 700; color: var(--ink); white-space: nowrap; }
      .skill-items { color: var(--muted); }

      /* Certifications — block paragraph; bold issuer lead-in, names wrap to the left margin */
      .cert-row { }
      .cert-issuer  { font-weight: 700; color: var(--ink); white-space: nowrap; }
      .cert-names   { color: var(--muted); }

      /* Education */
      .edu-degree { font-weight: 700; color: var(--ink); }
      .edu-inst   { color: var(--muted); font-weight: 500; }
      .edu-meta   { color: var(--dim); }

      /* Tagline — italic subtitle under role title in header */
      .cv-tagline { font-style: italic; color: var(--muted); }

      /* Achievement list — blue dot bullets, matching experience (and original CV) */
      .ach-list { list-style: none; }
      .ach-list li { color: var(--soft); line-height: 1.5; padding-left: 1.1em; position: relative; }
      .ach-list li::before { content: '•'; color: var(--accent); font-weight: 700; position: absolute; left: 0; }

      /* Languages */
      .lang-row { color: var(--muted); }
      .lang-row strong { color: var(--ink); font-weight: 600; }

      /* Continuation section — page 2 experience rolls on without border or padding */
      .cv-section-cont { border-top: none; }

      /* Photo — plain square, subtle hairline border (matches original CV) */
      .cv-photo-frame {
        flex-shrink: 0;
        display: inline-block;
      }
      .cv-photo {
        object-fit: cover; border-radius: 6px;
        display: block;
        border: 1px solid var(--rule);
      }

      /* ─── SCREEN ──────────────────────────────────────────── */
      @media screen {
        body {
          background: #e8f0f8;
          font-size: 14px;
          line-height: 1.65;
        }

        /* Top bar */
        .top-bar {
          position: sticky; top: 0; z-index: 20;
          background: white; border-bottom: 1px solid var(--rule);
          padding: 0.75rem 1.5rem;
          display: flex; align-items: center; justify-content: space-between; gap: 1rem;
          box-shadow: 0 1px 8px rgba(10,22,40,0.07);
        }
        .top-bar-brand {
          display: flex; align-items: center; gap: 0.6rem;
          text-decoration: none; color: var(--ink); font-weight: 700; font-size: 0.9rem;
        }
        .top-bar-brand .avatar {
          width: 32px; height: 32px; border-radius: 8px;
          background: linear-gradient(135deg, #0078D4, #50E6FF);
          display: flex; align-items: center; justify-content: center;
          color: white; font-size: 0.78rem; font-weight: 800;
        }
        .top-bar-actions { display: flex; gap: 0.75rem; align-items: center; }
        .btn-back {
          display: inline-flex; align-items: center; gap: 0.4rem;
          font-size: 0.8rem; font-weight: 600; color: var(--muted);
          text-decoration: none; padding: 0.4rem 0.75rem;
          border-radius: 6px; border: 1px solid var(--rule);
          transition: color 0.2s, border-color 0.2s;
        }
        .btn-back:hover { color: var(--accent); border-color: var(--accent); }
        .btn-download {
          display: inline-flex; align-items: center; gap: 0.4rem;
          font-size: 0.8rem; font-weight: 700; color: white;
          background: var(--accent); border: none;
          padding: 0.45rem 1rem; border-radius: 6px;
          text-decoration: none;
          box-shadow: 0 2px 8px rgba(0,120,212,0.3);
          transition: background 0.2s, box-shadow 0.2s;
        }
        .btn-download:hover { background: #005a9e; box-shadow: 0 4px 14px rgba(0,120,212,0.4); }

        /* Outer scroll area */
        .cv-viewer { padding: 2rem 1rem 3rem; }

        /* Individual page card */
        .cv-page {
          max-width: 820px; margin: 0 auto;
          background: white; border-radius: 12px;
          box-shadow: 0 8px 40px rgba(10,22,40,0.12);
          padding: 3rem 3.5rem;
        }

        /* Gap between page cards — mimics PDF viewer page separator */
        .page-gap {
          max-width: 820px; margin: 0 auto;
          height: 3rem;
          display: flex; align-items: center; gap: 1rem;
        }
        .page-gap::before, .page-gap::after {
          content: ''; flex: 1; height: 1px; background: #cbd5e1;
        }
        .page-gap span {
          font-size: 0.68rem; font-weight: 700; letter-spacing: 0.12em;
          text-transform: uppercase; color: #94a3b8; white-space: nowrap;
        }

        /* Header */
        .cv-header { margin-bottom: 1.75rem; padding-bottom: 1.5rem; border-bottom: 3px solid var(--accent); display: flex; align-items: flex-start; gap: 1.5rem; }
        .cv-header-text { flex: 1; min-width: 0; }
        .cv-name   { font-size: 2.6rem; font-weight: 800; letter-spacing: -0.02em; line-height: 1.1; color: var(--accent); }
        .cv-title  { font-size: 1.05rem; color: var(--soft); font-weight: 600; margin-top: 0.2rem; }
        .cv-contact { margin-top: 0.65rem; font-size: 0.87rem; color: var(--muted); display: flex; flex-wrap: wrap; gap: 0.25rem 0.6rem; align-items: center; }
        .cv-contact .sep { color: var(--rule); }
        .cv-tagline { font-size: 0.87rem; margin-top: 0.25rem; }
        .cv-photo { width: 96px; height: 96px; margin-top: 0.25rem; }


        /* Sections */
        .cv-section { padding: 1.35rem 0; }
        .cv-section:last-child { padding-bottom: 0; }
        .section-head { font-size: 0.65rem; margin-bottom: 0.75rem; }

        /* Roles */
        .cv-role { margin-bottom: 1.25rem; }
        .cv-role:last-child { margin-bottom: 0; }
        .role-title  { font-size: 1rem; }
        .role-date   { font-size: 0.83rem; }
        .role-meta   { font-size: 0.88rem; margin: 0.1rem 0 0.35rem; display: block; }
        .role-desc   { font-size: 0.88rem; color: var(--muted); margin-bottom: 0.35rem; line-height: 1.5; }
        .role-bullets li { font-size: 0.87rem; margin-bottom: 0.2rem; }

        /* Skills */
        .skill-row   { margin-bottom: 0.35rem; font-size: 0.88rem; }
        .skill-row:last-child { margin-bottom: 0; }

        /* Certs */
        .cert-row    { margin-bottom: 0.35rem; font-size: 0.88rem; }
        .cert-row:last-child { margin-bottom: 0; }

        /* Achievements */
        .ach-list li { font-size: 0.88rem; margin-bottom: 0.25rem; }

        /* Languages */
        .lang-row { font-size: 0.88rem; }

        /* Education */
        .cv-edu { margin-bottom: 0.65rem; }
        .cv-edu:last-child { margin-bottom: 0; }
        .edu-degree { font-size: 0.95rem; }
        .edu-inst   { font-size: 0.85rem; margin-top: 0.1rem; display: block; }
        .edu-meta   { font-size: 0.8rem; margin-top: 0.1rem; display: block; }
      }

      /* ─── PRINT ───────────────────────────────────────────── */
      @media print {
        @page { size: A4; margin: 13mm 15mm; }
        .top-bar { display: none !important; }

        body {
          background: white;
          font-size: 10.5pt;
          line-height: 1.45;
          -webkit-print-color-adjust: exact;
          color-adjust: exact;
        }

        .cv-page { padding: 0; box-shadow: none; border-radius: 0; max-width: none; }
        .cv-page--two { break-before: page; }
        .page-gap { display: none; }

        .cv-header { margin-bottom: 0.7rem; padding-bottom: 0.55rem; border-bottom: 2pt solid var(--accent); display: flex; align-items: flex-start; gap: 1.4rem; }
        .cv-header-text { flex: 1; min-width: 0; }
        .cv-name   { font-size: 23pt; font-weight: 700; letter-spacing: -0.01em; color: var(--accent); }
        .cv-title  { font-size: 11.5pt; color: var(--soft); font-weight: 700; margin-top: 0.12rem; }
        .cv-contact { margin-top: 0.45rem; font-size: 9pt; color: var(--muted); display: flex; flex-wrap: wrap; gap: 0.1rem 0.55rem; }
        .cv-contact .sep { color: var(--dim); }
        .cv-tagline { font-size: 10pt; margin-top: 0.18rem; }
        .cv-photo { width: 84pt; height: 84pt; }

        /* Sections may break across the page boundary (override the global
           `section { page-break-inside: avoid }`); individual roles/edu items
           stay intact via their own break-inside: avoid. */
        .cv-section { padding: 0.45rem 0; page-break-inside: auto; break-inside: auto; }
        .section-head { font-size: 8pt; margin-bottom: 0.4rem; break-after: avoid; }

        .cv-role { margin-bottom: 0.55rem; break-inside: avoid; orphans: 3; widows: 3; }
        .cv-role:last-child { margin-bottom: 0; }
        .role-title { font-size: 11pt; }
        .role-date  { font-size: 9pt; }
        .role-meta  { font-size: 9.7pt; margin: 0.05rem 0 0.2rem; display: block; }
        .role-desc  { font-size: 9.8pt; margin-bottom: 0.18rem; line-height: 1.42; }
        .role-bullets li { font-size: 10pt; margin-bottom: 0.14rem; line-height: 1.42; }

        .skill-row   { margin-bottom: 0.26rem; font-size: 10pt; }
        .cert-row    { margin-bottom: 0.26rem; font-size: 10pt; }
        .ach-list li { font-size: 10pt; margin-bottom: 0.18rem; line-height: 1.42; }
        .lang-row    { font-size: 10pt; }

        .cv-edu { margin-bottom: 0.38rem; page-break-inside: avoid; }
        .cv-edu:last-child { margin-bottom: 0; }
        .edu-degree { font-size: 10.5pt; }
        .edu-inst   { font-size: 9.7pt; margin-top: 0.06rem; display: block; }
        .edu-meta   { font-size: 9pt; margin-top: 0.06rem; display: block; }
      }
    </style>
  </head>
  <body>

    <!-- Top bar (screen only) -->
    <nav class="top-bar" aria-label="CV navigation">
      <a href="/" class="top-bar-brand">
        <span class="avatar">CK</span>
        <span>ckaserer.dev</span>
      </a>
      <div class="top-bar-actions">
        <a href="/" class="btn-back">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
          </svg>
          Back to site
        </a>
        <a href="/clemens-kaserer-cv.pdf" download="clemens-kaserer-cv.pdf" class="btn-download">
          <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd"/>
          </svg>
          Download PDF
        </a>
      </div>
    </nav>

    <div class="cv-viewer">

      <!-- ═══ PAGE 1 ═══════════════════════════════════════════════════════ -->
      <div class="cv-page">

        <!-- Header -->
        <header class="cv-header">
          <div class="cv-header-text">
            <h1 class="cv-name">{cv.name}</h1>
            <p class="cv-title">{cv.title}</p>
            <p class="cv-tagline">{cv.tagline}</p>
            <p class="cv-contact">
              <span>📍 {cv.location}</span>
              <span class="sep">·</span>
              <a href={cv.website}>{cv.website.replace('https://', '')}</a>
              <span class="sep">·</span>
              <a href={`https://linkedin.com/in/${cv.linkedin}`}>linkedin.com/in/{cv.linkedin}</a>
              <span class="sep">·</span>
              <a href={`https://github.com/${cv.github}`}>github.com/{cv.github}</a>
            </p>
          </div>
          <div class="cv-photo-frame">
            <img src={cv.photo} alt={cv.name} class="cv-photo" />
          </div>
        </header>

        <!-- PROFILE -->
        <section class="cv-section">
          <span class="section-head">Profile</span>
          <p style="color: var(--soft); line-height: 1.6;">{cv.summary}</p>
        </section>

        <!-- SELECTED ACHIEVEMENTS -->
        {achievements.length > 0 && (
          <section class="cv-section">
            <span class="section-head">Selected Achievements</span>
            <ul class="ach-list">
              {achievements.map((a) => <li>{a}</li>)}
            </ul>
          </section>
        )}

        <!-- EXPERIENCE — page 1 roles -->
        <section class="cv-section">
          <span class="section-head">Experience</span>
          {page1Roles.map((role) => (
            <div class="cv-role">
              <div class="role-header">
                <span class="role-title">{role.title}</span>
                <span class="role-date">{formatDate(role.start)} – {formatDate(role.end)}</span>
              </div>
              <span class="role-meta">{role.company} · {role.location}</span>
              {role.description && <p class="role-desc">{role.description}</p>}
              <ul class="role-bullets">
                {role.highlights.map((h) => <li>{h}</li>)}
              </ul>
            </div>
          ))}
        </section>

      </div><!-- /cv-page 1 -->

      <!-- ═══ PAGE GAP (screen only — mimics PDF viewer page separator) ══ -->
      <div class="page-gap" aria-hidden="true">
        <span>Page 2 of 2</span>
      </div>

      <!-- ═══ PAGE 2 ═══════════════════════════════════════════════════════ -->
      <div class="cv-page cv-page--two">

        <!-- EXPERIENCE — continued (CERN + VAPC; no repeated heading) -->
        <section class="cv-section cv-section-cont">
          {page2Roles.map((role) => (
            <div class="cv-role">
              <div class="role-header">
                <span class="role-title">{role.title}</span>
                <span class="role-date">{formatDate(role.start)} – {formatDate(role.end)}</span>
              </div>
              <span class="role-meta">{role.company} · {role.location}</span>
              {role.description && <p class="role-desc">{role.description}</p>}
              <ul class="role-bullets">
                {role.highlights.map((h) => <li>{h}</li>)}
              </ul>
            </div>
          ))}
        </section>

        <!-- SKILLS -->
        <section class="cv-section">
          <span class="section-head">Skills</span>
          {skillGroups.map((group) => (
            <p class="skill-row">
              <span class="skill-label">{group.label}:</span>
              <span class="skill-items">{group.items.join(', ')}</span>
            </p>
          ))}
        </section>

        <!-- CERTIFICATIONS -->
        <section class="cv-section">
          <span class="section-head">Certifications</span>
          {certsByIssuer.map((group) => (
            <p class="cert-row">
              <span class="cert-issuer">{group.issuer}:</span>
              <span class="cert-names">
                {group.certs.map((cert, ci) => (
                  <>
                    {cert.url
                      ? <a href={cert.url} target="_blank" rel="noopener noreferrer">{cert.name}</a>
                      : <span>{cert.name}</span>
                    }
                    <span style="color: var(--dim);">{` (${cert.level ? cert.level + ' · ' : cert.description ? cert.description + ' · ' : ''}${cert.year})`}</span>
                    {ci < group.certs.length - 1 && <span style="color: var(--dim);"> · </span>}
                  </>
                ))}
              </span>
            </p>
          ))}
        </section>

        <!-- LANGUAGES -->
        {languages.length > 0 && (
          <section class="cv-section">
            <span class="section-head">Languages</span>
            <p class="lang-row">
              {languages.map((lang, i) => (
                <>
                  <strong>{lang.name}</strong> — {lang.level}
                  {i < languages.length - 1 && <span style="margin: 0 0.4rem; color: var(--dim);">·</span>}
                </>
              ))}
            </p>
          </section>
        )}

        <!-- EDUCATION -->
        <section class="cv-section">
          <span class="section-head">Education</span>
          {cv.education.map((edu) => (
            <div class="cv-edu">
              <div class="edu-degree">{edu.degree}</div>
              <span class="edu-inst">{edu.institution}</span>
              {(edu.start || edu.end) && (
                <span class="edu-meta">{[edu.start, edu.end].filter(Boolean).join(' — ')}</span>
              )}
            </div>
          ))}
        </section>

      </div><!-- /cv-page 2 -->

    </div><!-- /cv-viewer -->
  </body>
</html>
