---
import cv from '../data/cv.json';
import '../styles/global.css';

function formatDate(dateStr: string | null): string {
  if (!dateStr) return 'Present';
  const [year, month] = dateStr.split('-');
  const date = new Date(parseInt(year), parseInt(month) - 1);
  return date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{cv.name} — Curriculum Vitae</title>
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
      @page { margin: 14mm 14mm 16mm 14mm; }
      @media print {
        body { font-size: 9.5pt; }
        .page-break { page-break-before: always; }
        a { color: #0078D4 !important; text-decoration: none; }
        section { page-break-inside: avoid; }
      }
      * { box-sizing: border-box; }
      body {
        font-family: 'Inter', sans-serif;
        color: #0A1628;
        background: white;
        max-width: 820px;
        margin: 0 auto;
        padding: 2rem;
        line-height: 1.55;
        font-feature-settings: 'cv11', 'ss01';
      }

      /* Header with photo */
      .header {
        display: flex;
        gap: 1.5rem;
        align-items: center;
        padding-bottom: 1.25rem;
        border-bottom: 3px solid #0078D4;
        margin-bottom: 1.25rem;
      }
      .header-photo {
        width: 100px; height: 100px;
        border-radius: 14px;
        object-fit: cover;
        flex-shrink: 0;
        border: 3px solid #0078D4;
      }
      .header-text { flex: 1; }
      h1 {
        font-size: 1.85rem;
        font-weight: 800;
        color: #0A1628;
        letter-spacing: -0.02em;
        margin: 0 0 0.15rem;
      }
      .subtitle {
        color: #0078D4;
        font-size: 1rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
      }
      .contact {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1rem;
        font-size: 0.78rem;
        color: #64748B;
      }
      .contact a { color: #0078D4; text-decoration: none; font-weight: 500; }

      /* Sections */
      h2 {
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        color: #0078D4;
        margin: 1.4rem 0 0.65rem;
        padding-bottom: 0.3rem;
        border-bottom: 1px solid #E2E8F0;
      }
      h3 {
        font-size: 0.95rem;
        font-weight: 700;
        color: #0A1628;
        margin: 0;
      }

      .summary { color: #334155; font-size: 0.88rem; line-height: 1.6; }

      .role { margin-bottom: 0.85rem; }
      .role-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1rem;
      }
      .role-date { color: #64748B; font-size: 0.78rem; font-weight: 500; white-space: nowrap; }
      .role-company {
        color: #0078D4;
        font-size: 0.85rem;
        font-weight: 600;
        margin: 0.1rem 0 0.35rem;
      }
      .role-desc { color: #475569; font-size: 0.83rem; margin: 0 0 0.35rem; }

      ul { margin: 0.3rem 0 0 1.1rem; padding: 0; }
      li { font-size: 0.82rem; color: #1e293b; margin-bottom: 0.18rem; }

      .skills-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.5rem 1.5rem;
      }
      .skill-group h3 { font-size: 0.78rem; font-weight: 700; color: #0A1628; margin-bottom: 0.2rem; }
      .skill-list { font-size: 0.78rem; color: #475569; }

      .cert-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.4rem 1rem; }
      .cert { display: flex; gap: 0.5rem; align-items: baseline; }
      .cert-bullet { color: #0078D4; font-weight: bold; }
      .cert-name { font-size: 0.83rem; font-weight: 500; color: #0A1628; text-decoration: none; }
      a.cert-name { color: #0078D4; }
      .cert-meta { font-size: 0.75rem; color: #64748B; margin-left: 0.25rem; }

      .edu { margin-bottom: 0.5rem; }
      .edu-meta { font-size: 0.78rem; color: #64748B; margin-top: 0.1rem; }
    </style>
  </head>
  <body>
    <!-- Header with photo -->
    <header class="header">
      {cv.photo && (
        <img src={cv.photo} alt={cv.name} class="header-photo"/>
      )}
      <div class="header-text">
        <h1>{cv.name}</h1>
        <div class="subtitle">{cv.title}</div>
        <div class="contact">
          <span>📍 {cv.location}</span>
          <a href={`mailto:${cv.email}`}>{cv.email}</a>
          <a href={cv.website}>{cv.website.replace('https://', '')}</a>
          <a href={`https://github.com/${cv.github}`}>github.com/{cv.github}</a>
          <a href={`https://linkedin.com/in/${cv.linkedin}`}>linkedin.com/in/{cv.linkedin}</a>
        </div>
      </div>
    </header>

    <!-- Summary -->
    <section>
      <h2>Profile</h2>
      <p class="summary">{cv.summary}</p>
    </section>

    <!-- Experience -->
    <section>
      <h2>Experience</h2>
      {cv.experience.map((employer) =>
        employer.roles.map((role) => (
          <div class="role">
            <div class="role-header">
              <h3>{role.title}</h3>
              <span class="role-date">{formatDate(role.start)} — {formatDate(role.end)}</span>
            </div>
            <div class="role-company">{employer.company} · {role.location}</div>
            <p class="role-desc">{role.description}</p>
            <ul>
              {role.highlights.map((h) => <li>{h}</li>)}
            </ul>
          </div>
        ))
      )}
    </section>

    <!-- Skills -->
    <section>
      <h2>Skills</h2>
      <div class="skills-grid">
        <div class="skill-group">
          <h3>Azure Platform</h3>
          <div class="skill-list">{cv.skills.azurePlatform.join(' · ')}</div>
        </div>
        <div class="skill-group">
          <h3>Cloud-Native & Containers</h3>
          <div class="skill-list">{cv.skills.cloudNative.join(' · ')}</div>
        </div>
        <div class="skill-group">
          <h3>IaC & CI/CD</h3>
          <div class="skill-list">{cv.skills.iacCicd.join(' · ')}</div>
        </div>
        <div class="skill-group">
          <h3>AI-Augmented Engineering</h3>
          <div class="skill-list">{cv.skills.ai.join(' · ')}</div>
        </div>
        <div class="skill-group">
          <h3>Languages & Scripting</h3>
          <div class="skill-list">{cv.skills.languages.join(' · ')}</div>
        </div>
        <div class="skill-group">
          <h3>Leadership & Practices</h3>
          <div class="skill-list">{cv.skills.practices.join(' · ')}</div>
        </div>
      </div>
    </section>

    <!-- Certifications -->
    <section>
      <h2>Certifications</h2>
      <div class="cert-grid">
        {cv.certifications.map((cert) => (
          <div class="cert">
            <span class="cert-bullet">▸</span>
            <div>
              {cert.url ? (
                <a class="cert-name" href={cert.url}>{cert.name}</a>
              ) : (
                <span class="cert-name">{cert.name}</span>
              )}
              <div class="cert-meta">{cert.issuer} · {cert.year}</div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Education -->
    <section>
      <h2>Education</h2>
      {cv.education.map((edu) => (
        <div class="edu">
          <h3>{edu.degree}</h3>
          <div class="edu-meta">{edu.institution}{[edu.start, edu.end].filter(Boolean).length ? ' · ' + [edu.start, edu.end].filter(Boolean).join(' — ') : ''}</div>
        </div>
      ))}
    </section>
  </body>
</html>
