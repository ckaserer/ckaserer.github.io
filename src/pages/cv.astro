---
import cv from '../data/cv.json';
import '../styles/global.css';

function formatDate(dateStr: string | null): string {
  if (!dateStr) return 'Present';
  const [year, month] = dateStr.split('-');
  const date = new Date(parseInt(year), parseInt(month) - 1);
  return date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
}

const flatRoles = cv.experience.flatMap((employer) =>
  employer.roles.map((role) => ({ ...role, company: employer.company }))
);

const p1Roles   = flatRoles.slice(0, 2);   // Manager + Senior Consultant (Avanade)
const pastRoles = flatRoles.slice(2);       // Gepardec, Accenture, CERN

const sortedCerts = [
  ...cv.certifications.filter(c => c.issuer === 'Microsoft').sort((a, b) => Number(b.year) - Number(a.year)),
  ...cv.certifications.filter(c => c.issuer !== 'Microsoft').sort((a, b) => Number(b.year) - Number(a.year)),
];

const skillGroups = [
  { label: 'Azure Platform',                items: cv.skills.azurePlatform },
  { label: 'Cloud-Native & Containers',     items: cv.skills.cloudNative   },
  { label: 'Automation, CI/CD & Scripting', items: cv.skills.automation    },
  { label: 'AI-Augmented Engineering',      items: cv.skills.ai            },
  { label: 'Leadership & Practices',        items: cv.skills.practices     },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{cv.name} — Curriculum Vitae</title>
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
      @page { size: A4; margin: 14mm 14mm 15mm 14mm; }
      @media print { a { color: #0078D4 !important; text-decoration: none; } }
      * { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --ink:     #0A1628;
        --soft:    #1e293b;
        --muted:   #475569;
        --dim:     #64748B;
        --rule:    #E2E8F0;
        --accent:  #0078D4;
        --accent2: #e8f3fc;
      }

      body {
        font-family: 'Inter', sans-serif;
        color: var(--ink);
        background: white;
        font-size: 9.5pt;
        line-height: 1.55;
        font-feature-settings: 'cv11', 'ss01';
      }

      /* ── Two-column grid (reused both pages) ── */
      .page {
        display: grid;
        grid-template-columns: 62mm 1fr;
        gap: 9mm;
        align-items: start;
      }
      .page-2 {
        page-break-before: always;
        break-before: page;
      }

      /* ── Sidebar shared ── */
      .sidebar { padding-right: 7mm; border-right: 1px solid var(--rule); }

      .sb-block { margin-bottom: 1.35rem; }
      .sb-block:last-child { margin-bottom: 0; }

      .sb-head {
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--accent);
        margin-bottom: 0.55rem;
        display: block;
      }

      /* Photo */
      .photo-wrap {
        width: 100%;
        aspect-ratio: 1/1;
        border-radius: 12px;
        overflow: hidden;
        border: 2px solid var(--accent);
        margin-bottom: 1.25rem;
      }
      .photo-wrap img { width: 100%; height: 100%; object-fit: cover; display: block; }

      /* Contact */
      .contact-list { list-style: none; font-size: 0.79rem; }
      .contact-list li { margin-bottom: 0.3rem; color: var(--muted); line-height: 1.4; word-break: break-word; }
      .contact-list a { color: var(--accent); font-weight: 500; text-decoration: none; }

      /* Certs */
      .cert { margin-bottom: 0.48rem; page-break-inside: avoid; }
      .cert:last-child { margin-bottom: 0; }
      .cert-name { font-size: 0.77rem; font-weight: 600; display: block; line-height: 1.3; color: var(--ink); text-decoration: none; }
      a.cert-name { color: var(--accent); }
      .cert-meta { font-size: 0.69rem; color: var(--dim); margin-top: 0.04rem; }

      /* Education */
      .edu { margin-bottom: 0.55rem; page-break-inside: avoid; }
      .edu:last-child { margin-bottom: 0; }
      .edu-degree { font-size: 0.8rem; font-weight: 700; color: var(--ink); line-height: 1.25; }
      .edu-inst   { font-size: 0.73rem; color: var(--accent); font-weight: 600; margin-top: 0.05rem; }
      .edu-meta   { font-size: 0.69rem; color: var(--dim); }

      /* Skills (sidebar chips — page 2) */
      .skill-cluster { margin-bottom: 0.8rem; page-break-inside: avoid; }
      .skill-cluster:last-child { margin-bottom: 0; }
      .cluster-label {
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--ink);
        margin-bottom: 0.32rem;
        display: block;
      }
      .chips { display: flex; flex-wrap: wrap; gap: 0.28rem; }
      .chip {
        font-size: 0.71rem;
        font-weight: 500;
        color: var(--soft);
        background: var(--accent2);
        border: 1px solid #b8d9f5;
        border-radius: 999px;
        padding: 0.1rem 0.48rem 0.12rem;
        line-height: 1.3;
        white-space: nowrap;
      }

      /* ── Main column ── */
      .main { min-width: 0; }

      /* Identity (page 1 only) */
      .identity {
        padding-bottom: 0.7rem;
        border-bottom: 3px solid var(--accent);
        margin-bottom: 0.95rem;
      }
      h1 {
        font-size: 1.9rem;
        font-weight: 800;
        color: var(--ink);
        letter-spacing: -0.02em;
        line-height: 1.1;
        margin-bottom: 0.15rem;
      }
      .job-title { color: var(--accent); font-size: 1rem; font-weight: 600; }

      /* Section heading */
      .section-head {
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--accent);
        margin: 0 0 0.55rem;
        display: block;
      }
      .section-wrap { margin-bottom: 1rem; }
      .section-wrap:last-child { margin-bottom: 0; }

      /* Profile */
      .summary { color: var(--muted); font-size: 0.9rem; line-height: 1.6; }

      /* Roles */
      .role { margin-bottom: 0.95rem; }
      .role:last-child { margin-bottom: 0; }
      .role-top {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 0.5rem;
      }
      .role-top h3 { font-size: 0.96rem; font-weight: 700; color: var(--ink); }
      .role-date { font-size: 0.77rem; color: var(--dim); font-weight: 500; white-space: nowrap; }
      .role-co { font-size: 0.83rem; font-weight: 600; color: var(--accent); margin: 0.08rem 0 0.28rem; }
      .role-desc { font-size: 0.83rem; color: var(--muted); line-height: 1.5; margin-bottom: 0.28rem; }
      .role ul { margin-left: 1rem; }
      .role li { font-size: 0.82rem; color: var(--soft); line-height: 1.5; margin-bottom: 0.14rem; }

      /* Page-2 section continuation label */
      .continued-head {
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--accent);
        margin-bottom: 0.65rem;
        padding-top: 0;
        display: block;
      }
    </style>
  </head>
  <body>

    <!-- ══════════════════════ PAGE 1 ══════════════════════ -->
    <div class="page">

      <!-- Sidebar: photo · contact · certs · education -->
      <aside class="sidebar">
        {cv.photo && (
          <div class="photo-wrap">
            <img src={cv.photo} alt={cv.name} />
          </div>
        )}

        <div class="sb-block">
          <span class="sb-head">Contact</span>
          <ul class="contact-list">
            <li>📍 {cv.location}</li>
            <li><a href={cv.website}>{cv.website.replace('https://', '')}</a></li>
            <li><a href={`https://github.com/${cv.github}`}>github.com/{cv.github}</a></li>
            <li><a href={`https://linkedin.com/in/${cv.linkedin}`}>linkedin.com/in/{cv.linkedin}</a></li>
          </ul>
        </div>

        <div class="sb-block">
          <span class="sb-head">Certifications</span>
          {sortedCerts.map((cert) => (
            <div class="cert">
              {cert.url
                ? <a class="cert-name" href={cert.url}>{cert.name}</a>
                : <span class="cert-name">{cert.name}</span>
              }
              <div class="cert-meta">{cert.issuer} · {cert.year}</div>
            </div>
          ))}
        </div>

        <div class="sb-block">
          <span class="sb-head">Education</span>
          {cv.education.map((edu) => (
            <div class="edu">
              <div class="edu-degree">{edu.degree}</div>
              <div class="edu-inst">{edu.institution}</div>
              {[edu.start, edu.end].filter(Boolean).length > 0 && (
                <div class="edu-meta">{[edu.start, edu.end].filter(Boolean).join(' — ')}</div>
              )}
            </div>
          ))}
        </div>
      </aside>

      <!-- Main: identity · profile · current role -->
      <main class="main">
        <header class="identity">
          <h1>{cv.name}</h1>
          <span class="job-title">{cv.title}</span>
        </header>

        <div class="section-wrap">
          <span class="section-head">Profile</span>
          <p class="summary">{cv.summary}</p>
        </div>

        <div class="section-wrap">
          <span class="section-head">Experience</span>
          {p1Roles.map((role) => (
            <div class="role">
              <div class="role-top">
                <h3>{role.title}</h3>
                <span class="role-date">{formatDate(role.start)} — {formatDate(role.end)}</span>
              </div>
              <div class="role-co">{role.company} · {role.location}</div>
              <p class="role-desc">{role.description}</p>
              <ul>
                {role.highlights.map((h) => <li>{h}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </main>
    </div>

    <!-- ══════════════════════ PAGE 2 ══════════════════════ -->
    <div class="page page-2">

      <!-- Sidebar: skills -->
      <aside class="sidebar">
        <div class="sb-block">
          <span class="sb-head">Skills</span>
          {skillGroups.map((group) => (
            <div class="skill-cluster">
              <span class="cluster-label">{group.label}</span>
              <div class="chips">
                {group.items.map((skill) => (
                  <span class="chip">{skill}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </aside>

      <!-- Main: remaining experience -->
      <main class="main">
        <span class="continued-head">Experience (continued)</span>
        {pastRoles.map((role) => (
          <div class="role">
            <div class="role-top">
              <h3>{role.title}</h3>
              <span class="role-date">{formatDate(role.start)} — {formatDate(role.end)}</span>
            </div>
            <div class="role-co">{role.company} · {role.location}</div>
            <p class="role-desc">{role.description}</p>
            <ul>
              {role.highlights.map((h) => <li>{h}</li>)}
            </ul>
          </div>
        ))}
      </main>
    </div>

  </body>
</html>
