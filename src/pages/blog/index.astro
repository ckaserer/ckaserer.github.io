---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const posts = (await getCollection('blog', ({ data }) => import.meta.env.PROD ? !data.draft : true))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Base
  title="Blog — Clemens Kaserer"
  description="Notes on facilitating technical workshops, engineering leadership, and building with AI."
  canonical="https://ckaserer.dev/blog"
>
  <Nav current="blog" />

  <section class="pt-32 pb-24 px-6 md:px-12 lg:px-16">
    <div class="max-w-3xl mx-auto">
      <p class="section-label mb-4">Blog</p>
      <h1 class="section-heading">Notes from the field</h1>
      <p class="section-subheading">
        Lessons from facilitating workshops, leading engineering teams, and building with AI — written up as I go.
      </p>

      <ul class="mt-16 flex flex-col gap-10">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}`} class="group block">
              <time datetime={post.data.pubDate.toISOString()} class="text-sm text-muted">
                {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
              <h2 class="font-display font-bold text-navy text-2xl mt-2 group-hover:text-azure transition-colors">
                {post.data.title}
              </h2>
              <p class="text-muted mt-2 leading-relaxed">{post.data.description}</p>
              {post.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-2 mt-4">
                  {post.data.tags.map((tag) => (
                    <span class="pill pointer-events-none text-xs">{tag}</span>
                  ))}
                </div>
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Footer />
</Base>
